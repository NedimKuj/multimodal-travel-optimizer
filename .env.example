# Travelpayouts / Aviasales Flights Data API.
# Obtain from the Travelpayouts partner dashboard. Never commit the real value.
AVIASALES_API_TOKEN=

# Affiliate marker. Without it the adapter emits no booking links
# rather than unattributed ones.
AVIASALES_MARKER=

# Optional overrides.
# AVIASALES_BASE_URL=https://api.travelpayouts.com
# AVIASALES_BOOKING_BASE_URL=https://www.aviasales.com
# AVIASALES_TIMEOUT_MS=10000
# AVIASALES_CURRENCY=EUR
