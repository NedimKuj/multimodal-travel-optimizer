{
  "name": "travel-optimizer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "pretypecheck": "pnpm -r --filter '!@travel-optimizer/web' build",
    "typecheck": "pnpm -r typecheck",
    "prelint": "pnpm -r --filter '!@travel-optimizer/web' build",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm -r --filter '!@travel-optimizer/web' build && pnpm --filter @travel-optimizer/web build",
    "dev:web": "pnpm --filter @travel-optimizer/web dev",
    "geo:fetch": "pnpm --filter @travel-optimizer/geo build && pnpm --filter @travel-optimizer/geo fetch:reference-data",
    "aviasales:probe": "pnpm --filter @travel-optimizer/providers build && node --env-file-if-exists=.env packages/providers/dist/bin/aviasales-probe.js",
    "test:live": "PROVIDER_LIVE=1 node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "trip-search": "pnpm --filter @travel-optimizer/cli build && node --env-file-if-exists=.env packages/cli/dist/bin/trip-search.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
